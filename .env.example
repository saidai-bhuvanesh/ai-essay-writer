# STUDX JARVIS - Local AI Assistant Configuration
# =============================================

# Application Settings
APP_NAME=STUDX JARVIS
VERSION=v1.0
OWNER=Bhuvi
ENVIRONMENT=local

# Database
DATABASE_PATH=./database/jarvis_db.sqlite
DATABASE_ENCRYPTION=true

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs/
ACTIVITY_LOG=true

# Voice Settings
STT_ENGINE=whisper
TTS_ENGINE=pyttsx3
WAKE_WORD=jarvis
SAMPLE_RATE=16000
LANGUAGE=en

# AI/LLM Settings
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3
TEMPERATURE=0.7
MAX_TOKENS=2048

# Security
AUTHENTICATION_ENABLED=true
FACE_RECOGNITION_ENABLED=true
PERMISSION_LEVELS=3
KILL_SWITCH_ENABLED=true
AUDIT_LOGGING=true

# Vision Settings
CAMERA_INDEX=0
GESTURE_DETECTION=true
OBJECT_DETECTION=true

# Browser Automation
BROWSER_AUTOMATION=true
PLAYWRIGHT_HEADLESS=false
DEFAULT_BROWSER=chrome

# Memory Settings
MEMORY_RETENTION_DAYS=365
CONVERSATION_CONTEXT_LIMIT=10

# System Automation
SYSTEM_AUTOMATION=true
AUTO_START=false
MAX_CONCURRENT_TASKS=5